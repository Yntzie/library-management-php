{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(css|js|asset|uploads)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|gif|webp|svg|ico|css|js|map|txt))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}

